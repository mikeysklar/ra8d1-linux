/*
 * EK-RA8D1 wiring for the arcade app.
 *
 * Everything in this file is specific to this board: node labels like
 * `uart9`, `s28hl512t` and `zephyr_lcdif` exist on the EK-RA8D1 and nowhere
 * else. Porting to another Zephyr board means writing a sibling file here,
 * `boards/<board>.overlay`, and changing no source.
 *
 * Note there is deliberately no `app.overlay`. Zephyr picks the application
 * devicetree overlay by a fallback chain, not a merge (see
 * cmake/modules/configuration_files.cmake): once `boards/<board>.overlay`
 * exists it is used and `app.overlay` is never read. Keeping both would mean
 * the second one silently does nothing. Genuinely board-neutral devicetree,
 * if we ever have any, belongs in a `.dtsi` included from each board file.
 *
 * Kconfig is the other way round: `prj.conf` and `boards/<board>.conf` are
 * merged, so the board-specific Kconfig lives in the sibling `.conf`.
 */

/* Console at 921600 rather than 115200. Pushing a ROM image is only ~25 KB
 * for Pac-Man so the baud hardly matters here, but the rvlinux app on this
 * board already runs its console at this rate and the J-Link OB VCOM handles
 * it, so one terminal setting works for both. */
&uart9 {
	current-speed = <921600>;
};

/*
 * Carve a ROM slot out of the octo-SPI NOR.
 *
 * The board DTS declares a single "nor" partition covering all 64 MB. Split
 * it so the arcade ROM has a named home the app can find by label, instead
 * of a hardcoded 0x400000 in C.
 *
 * The layout below matches what is already on this part: 0x0-0x1FFFF is the
 * CIRCUITPY filesystem and 0x2000 is the OSPI driver's autocalibration
 * sector, and the emulated-Linux image sits from 0x40000 and runs to a few
 * MB. The arcade slot starts at 4 MB, clear of all of it, and is 2 MB, which
 * is ample: a full Pac-Man image is ~25 KB.
 */
&s28hl512t {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Everything the other apps on this board already use. */
		nor_partition: partition@0 {
			label = "nor";
			reg = <0x00000000 0x00400000>;
		};

		arcade_rom_partition: partition@400000 {
			label = "arcade-rom";
			reg = <0x00400000 0x00200000>;
		};

		/* The rest of the 64 MB part, unclaimed. */
		nor_spare_partition: partition@600000 {
			label = "nor-spare";
			reg = <0x00600000 0x3fa00000>;
		};
	};
};

/*
 * Black the letterbox.
 *
 * The arcade raster is 224x288 and the panel is 480x854, so the scaled image
 * never fills the screen and the GLCDC paints the surround with its default
 * background colour. The driver defaults every channel to 255
 * (display_renesas_ra.h, DT_INST_PROP_OR(n, def_back_color_*, 255)), so
 * without this the border comes up white.
 *
 * `zephyr_lcdif` is labelled in ek_ra8d1.dts itself, not in the shield, so
 * this is safe to apply to a headless build too: the node is simply disabled
 * and these properties go nowhere.
 */
&zephyr_lcdif {
	def-back-color-red = <0>;
	def-back-color-green = <0>;
	def-back-color-blue = <0>;
};
