From d65786e8b3127ac159faa56fb9d8fa6bdd2667db Mon Sep 17 00:00:00 2001
From: RA8D1 port <noreply@example.invalid>
Date: Fri, 7 Aug 2026 13:54:17 +0000
Subject: [PATCH 3/4] zephyr-cp: mirror the console to the chosen console UART

On boards where the USB CDC link is unavailable or moves no bytes, there
is no console at all and no way to reach the REPL. The Zephyr chosen
console UART is often wired to the on-board debug probe's virtual COM
port, which is reachable over the same cable used for flashing.

Mirror console traffic to that UART in addition to USB CDC:

  - write the UART first in port_serial_write_substring, so output
    survives a stalled CDC path or a NULL usb_console
  - drain the UART first in port_serial_read
  - sum both transports in port_serial_bytes_available
  - report connected when the mirror is up

Additive; USB CDC remains the primary console where it works. The console
RX buffer is raised from 64 to 2048 bytes, as 64 overflows during
filesystem writes.
---
 ports/zephyr-cp/supervisor/serial.c | 43 +++++++++++++++++++++++++++--
 1 file changed, 40 insertions(+), 3 deletions(-)

diff --git a/ports/zephyr-cp/supervisor/serial.c b/ports/zephyr-cp/supervisor/serial.c
index 3ae3e73fa..9b02554ab 100644
--- a/ports/zephyr-cp/supervisor/serial.c
+++ b/ports/zephyr-cp/supervisor/serial.c
@@ -11,16 +11,28 @@
 #if CIRCUITPY_USB_DEVICE == 1
 #include "shared-bindings/usb_cdc/Serial.h"
 usb_cdc_serial_obj_t *usb_console;
+// FEAT-CONSOLE-MIRROR: also mirror console output to the Zephyr console UART
+// (uart9 on EK-RA8D1 = the J-Link OB VCOM) so output is visible even when the
+// USB CDC link moves no bytes. Additive: USB remains the primary console.
+#include "shared-bindings/busio/UART.h"
+static busio_uart_obj_t uart_console;
+static uint8_t buffer[2048];
+static bool uart_mirror_ready = false;
 #else
 #include "shared-bindings/busio/UART.h"
 static busio_uart_obj_t uart_console;
-static uint8_t buffer[64];
+static uint8_t buffer[2048];
 #endif
 
 void port_serial_early_init(void) {
     #if CIRCUITPY_USB_DEVICE == 0
     uart_console.base.type = &busio_uart_type;
     common_hal_busio_uart_construct_from_device(&uart_console, DEVICE_DT_GET(DT_CHOSEN(zephyr_console)), sizeof(buffer), buffer);
+    #else
+    // FEAT-CONSOLE-MIRROR
+    uart_console.base.type = &busio_uart_type;
+    common_hal_busio_uart_construct_from_device(&uart_console, DEVICE_DT_GET(DT_CHOSEN(zephyr_console)), sizeof(buffer), buffer);
+    uart_mirror_ready = true;
     #endif
 }
 
@@ -32,6 +44,11 @@ void port_serial_init(void) {
 
 bool port_serial_connected(void) {
     #if CIRCUITPY_USB_DEVICE == 1
+    // FEAT-CONSOLE-MIRROR: the UART mirror is a real console. Report
+    // connected when it is up, regardless of the USB CDC link state.
+    if (uart_mirror_ready) {
+        return true;
+    }
     if (usb_console == NULL) {
         return false;
     }
@@ -43,6 +60,16 @@ bool port_serial_connected(void) {
 
 char port_serial_read(void) {
     #if CIRCUITPY_USB_DEVICE == 1
+    // FEAT-CONSOLE-MIRROR: prefer the UART mirror when it has a byte.
+    if (uart_mirror_ready &&
+        common_hal_busio_uart_rx_characters_available(&uart_console) > 0) {
+        char ubuf[1];
+        size_t ucount = common_hal_busio_uart_read(&uart_console,
+            (uint8_t *)ubuf, 1, NULL);
+        if (ucount > 0) {
+            return ubuf[0];
+        }
+    }
     if (usb_console == NULL) {
         return -1;
     }
@@ -64,10 +91,15 @@ char port_serial_read(void) {
 
 uint32_t port_serial_bytes_available(void) {
     #if CIRCUITPY_USB_DEVICE == 1
+    // FEAT-CONSOLE-MIRROR: count bytes waiting on either transport.
+    uint32_t uart_waiting = 0;
+    if (uart_mirror_ready) {
+        uart_waiting = common_hal_busio_uart_rx_characters_available(&uart_console);
+    }
     if (usb_console == NULL) {
-        return 0;
+        return uart_waiting;
     }
-    return common_hal_usb_cdc_serial_get_in_waiting(usb_console);
+    return uart_waiting + common_hal_usb_cdc_serial_get_in_waiting(usb_console);
     #else
     return common_hal_busio_uart_rx_characters_available(&uart_console);
     #endif
@@ -75,6 +107,11 @@ uint32_t port_serial_bytes_available(void) {
 
 void port_serial_write_substring(const char *text, uint32_t length) {
     #if CIRCUITPY_USB_DEVICE == 1
+    // FEAT-CONSOLE-MIRROR: write the UART mirror FIRST so output survives
+    // even if the CDC path stalls or usb_console is NULL.
+    if (uart_mirror_ready) {
+        common_hal_busio_uart_write(&uart_console, (const uint8_t *)text, length, NULL);
+    }
     if (usb_console == NULL) {
         return;
     }
-- 
