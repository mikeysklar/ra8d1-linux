From 773cc16d7072bba3a40f262d06d44ba41b64a832 Mon Sep 17 00:00:00 2001
From: RA8D1 port <noreply@example.invalid>
Date: Fri, 7 Aug 2026 13:54:16 +0000
Subject: [PATCH 1/4] oofatfs: emit a valid boot jump in f_mkfs

f_mkfs wrote 0xEB 0xFE 0x90 as the FAT VBR boot jump. 0xEB 0xFE is
"jmp $" - a two-byte infinite loop. The conventional value is
0xEB 0x3C 0x90, a jump over the BPB to the boot code.

FatFs's own volume check only inspects the first byte, so every board
happily remounts its own volume and the defect goes unnoticed. Hosts
that validate the full jump (macOS) reject the boot sector and never
publish a block device for the drive.

Affects every board using this FatFs to format its filesystem.
---
 lib/oofatfs/ff.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/lib/oofatfs/ff.c b/lib/oofatfs/ff.c
index 8a5dcf222..29a32e83a 100644
--- a/lib/oofatfs/ff.c
+++ b/lib/oofatfs/ff.c
@@ -5772,7 +5772,12 @@ FRESULT f_mkfs (
 #endif
         /* Create FAT VBR */
         mem_set(buf, 0, ss);
-        mem_cpy(buf + BS_JmpBoot, "\xEB\xFE\x90" "MSDOS5.0", 11);/* Boot jump code (x86), OEM name */
+        /* FIX-FAT-BOOTJUMP: upstream emitted \xEB\xFE ("jmp $", an
+         * infinite loop). Strict hosts (macOS) reject the boot sector
+         * and never publish a block device. 0xEB 0x3C 0x90 is the
+         * conventional jump over the BPB. FatFs own check (~3118)
+         * only looks at the first byte, hence unnoticed. */
+        mem_cpy(buf + BS_JmpBoot, "\xEB\x3C\x90" "MSDOS5.0", 11);/* Boot jump code (x86), OEM name */
         st_word(buf + BPB_BytsPerSec, ss);              /* Sector size [byte] */
         buf[BPB_SecPerClus] = (BYTE)pau;                /* Cluster size [sector] */
         st_word(buf + BPB_RsvdSecCnt, (WORD)sz_rsv);    /* Size of reserved area */
