From 66ab2f22013e7f644c9a919532515e934f8cde09 Mon Sep 17 00:00:00 2001
From: RA8D1 port <noreply@example.invalid>
Date: Fri, 7 Aug 2026 13:54:17 +0000
Subject: [PATCH 4/4] zephyr-cp: propagate disk_read failures in the MSC read
 path

_zephyr_disk_read() called disk_read() and discarded its return value,
returning 0 unconditionally. A failed read therefore reported success to
the host while handing back whatever was in the buffer.

Return -EIO when the underlying read fails.
---
 ports/zephyr-cp/supervisor/usb.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/ports/zephyr-cp/supervisor/usb.c b/ports/zephyr-cp/supervisor/usb.c
index a42a5192f..8bd38578c 100644
--- a/ports/zephyr-cp/supervisor/usb.c
+++ b/ports/zephyr-cp/supervisor/usb.c
@@ -124,7 +124,10 @@ int _zephyr_disk_read(struct disk_info *disk, uint8_t *data_buf, uint32_t start_
     if (start_sector + num_sector > disk_block_count) {
         return -EIO;
     }
-    disk_read(root, data_buf, start_sector, num_sector);
+    int read_rc = disk_read(root, data_buf, start_sector, num_sector);  // FIX-MSC-READ-ERRNO
+    if (read_rc != 0) {
+        return -EIO;  // FIX-MSC-READ-ERRNO
+    }
     return 0;
 }
 
