# Application options.
#
# Zephyr uses this file as the Kconfig root when it exists in the application
# directory, so it must pull in the tree's own Kconfig at the end.

mainmenu "TinyEMU rv32 Sv32 Linux on EK-RA8D1"

config RVT_CMDLINE
	string "Guest kernel command line"
	default "console=ttyS0,115200 earlycon=sbi root=/dev/vda ro rootfstype=ext2"
	help
	  Placed in the generated devicetree as /chosen/bootargs.

	  The default assumes the rootfs slot holds an ext2 image, which is
	  what Buildroot produces and what the guest kernel can mount - it has
	  ext2 and ext4 built in and, checked against the image, no EROFS and
	  no squashfs. `ro` is not optional: the block device offers
	  VIRTIO_BLK_F_RO and rejects writes.

	  earlycon=sbi gets output from the very first line, before the 8250
	  driver exists, through the SBI debug console in emu/rv_hostsbi.c.

config RVT_FORCE_SELFTEST
	bool "Always run the built-in RV32 self-test"
	default n
	help
	  Ignore the kernel slot and boot src/testrom.h regardless of what is
	  in flash. The self-test is otherwise only reached when the slot holds
	  nothing bootable.

	  This is how the emulator gets characterised on a board whose flash
	  holds a guest it cannot boot, which is the normal state until a
	  kernel small enough for the 8 MB slot exists.

config RVT_CRC_ROOTFS
	bool "Verify the rootfs CRC at boot"
	default n
	help
	  The kernel slot is always verified: a half-written kernel otherwise
	  surfaces as a crash somewhere unrelated. The rootfs is not, by
	  default, because it is tens of megabytes of OSPI reads on every boot
	  to catch a corruption the filesystem itself would also catch.

	  Worth turning on while bringing up a new push path.

config RVT_UART_RX_RING
	int "Console receive ring filled by the UART ISR, in bytes"
	default 1024
	depends on UART_INTERRUPT_DRIVEN
	help
	  The guest reads the console once per emulator slice (RV_SLICE_INSNS
	  instructions, ~667 us at 15.37 MIPS) and uart_poll_in() holds one
	  byte between reads, so without an ISR and this ring a pasted line
	  loses most of its bytes. Losing the newline hangs the guest shell in
	  read() forever, which is why the symptom is a dead console rather
	  than mistyped input - BUILD.md gotcha 17.

	  Size it for the longest line pasted in one go. 1024 covers a
	  base64-encoded file chunk; the default emulator-side 8250 ring is
	  only 64 bytes but drains every slice, so it is not the constraint.

config RVT_EMU_PRIORITY
	int "Priority of the thread running the emulator step loop"
	default 10
	depends on NETWORKING
	help
	  rv_machine_run_bounded() never blocks and never yields - a guest WFI
	  returns early from riscv_cpu_interp() and spins - so with Zephyr's
	  priority-based preemption any thread numerically above it would never
	  run at all. The Renesas Ethernet RX thread sits at priority 2 and the
	  TCP worker at 2, so main() lowers itself to this value before the
	  image check. Guest instructions then run only in the time the network
	  stack does not want, which is nearly all of it.

menu "Guest telnet console"

config RVT_TELNET
	bool "Serve the guest console over TCP"
	default y
	depends on NETWORKING && NET_SOCKETS && NET_TCP && NET_IPV4
	help
	  Every byte of the guest's console already passes through
	  plat_putc()/plat_getc() - the 8250 model in emu/rv_machine.c and the
	  SBI debug console in emu/rv_hostsbi.c both go through them - so this
	  option adds a TCP listener that takes over both ends while a client
	  is attached, and a plain `telnet <board-ip>` lands on the guest's
	  root shell. Nothing under emu/ changes and nothing in the guest can
	  tell.

	  With no client attached the console falls back to the physical UART,
	  which is how the board is debugged.

if RVT_TELNET

config RVT_TELNET_PORT
	int "TCP port"
	default 23

config RVT_TELNET_TX_RING
	int "Guest-to-client buffer, bytes (power of two)"
	default 8192
	help
	  Sized to absorb a kernel boot log burst without dropping. The
	  emulator never blocks on this ring; once it is full, further guest
	  output is discarded and counted, which is the only policy that does
	  not risk stalling guest execution behind a TCP retransmit timeout.

config RVT_TELNET_RX_RING
	int "Client-to-guest buffer, bytes (power of two)"
	default 1024

config RVT_TELNET_MIRROR_UART
	bool "Also copy guest output to the UART while a client is attached"
	default n
	help
	  Handy when debugging the bridge itself. Costs one uart_poll_out()
	  per guest character on the emulator's hot path, which at 921600 baud
	  is about 11 us of busy-wait per byte, so leave it off normally.

config RVT_TELNET_THREAD_PRIORITY
	int "Telnet thread priority"
	default 5
	help
	  Must outrank RVT_EMU_PRIORITY and rank below the networking threads
	  at 2.

config RVT_TELNET_THREAD_STACK
	int "Telnet thread stack size"
	default 4096

endif # RVT_TELNET

endmenu

menu "TCP image pusher"

config RVT_PUSHER
	bool "Serve the RA8LDR image loader over TCP"
	default y
	depends on NETWORKING && NET_SOCKETS && NET_TCP && NET_IPV4 && FLASH
	select REBOOT
	help
	  Accept guest images on a TCP port, in the same wire format the
	  rvlinux app on this board already serves, so
	  ra8d1-linux/rvlinux/tools/pushimage.py drives this build unchanged.
	  Without it the only way to replace a guest image is to flash the
	  other application, push, and flash back - BUILD.md gotcha 14, which
	  costs a working board every time someone forgets that the two apps
	  boot different kernels.

	  REBOOT is selected rather than assumed: unlike rvlinux, a push here
	  stops the guest (see src/pusher.c) and the board has to restart to
	  bring it back.

if RVT_PUSHER

config RVT_PUSHER_PORT
	int "TCP port"
	default 5555
	help
	  pushimage.py's default. Changing it means passing HOST:PORT to the
	  tool, which it supports.

config RVT_PUSHER_REBOOT_DELAY_S
	int "Seconds after a successful push before the board reboots"
	default 30
	help
	  A push stops the guest, so the board has to reboot for the new image
	  to run. It is deferred rather than immediate because the normal
	  operation is two pushes back to back - kernel, then rootfs - and
	  rebooting between them would boot a new kernel against the old
	  rootfs and make the operator wait out DHCP before the second push.
	  Any connection arriving inside the window pushes the deadline out
	  again, so the board restarts once the pushing stops.

	  0 disables the automatic reboot entirely; the board then sits with a
	  stopped guest until it is reset.

config RVT_PUSHER_HALT_MS
	int "Milliseconds to wait for the emulator to stop before refusing"
	default 5000
	help
	  rv_request_poweroff() takes effect at the next instruction-slice
	  boundary, which is ~667 us at the measured 15.37 MIPS, so this is
	  three orders of magnitude of headroom. It is a bound rather than a
	  wait because the alternative to timing out is erasing flash while
	  the guest is still reading it.

config RVT_PUSHER_BLANK_CHECK
	bool "Verify a slot really is blank after erasing it"
	default y
	help
	  NOR erase reports success on a status bit and nothing checks that the
	  bits actually went to 1. A program can only clear bits, so writing
	  over an incompletely erased block yields the bitwise AND of old and
	  new: data that is present, stable across reads, and wrong - and
	  indistinguishable from a bad write once the payload is on top of it.
	  Checking before the first payload byte separates the two faults, at
	  the cost of one read pass over the erased region.

config RVT_PUSHER_VERIFY_ATTEMPTS
	int "How many times to read back and CRC a slot before failing a push"
	default 3
	help
	  A CRC32 that matches is worth trusting however many attempts it took,
	  so if any pass agrees the payload is right and the earlier passes were
	  bad reads. The count is the real product: pushes that routinely need a
	  second pass mean reads are marginal, which is a much more specific
	  finding than "verify failed".

	  Read attempts only. Nothing is rewritten between them and nothing may
	  be - this is Semper NOR with ECC over 16-byte units, and programming a
	  unit twice without an erase between corrupts it. A push that exhausts
	  its attempts fails, and pushimage.py's retry erases the slot first.

config RVT_PUSHER_RX_TIMEOUT_S
	int "Seconds a stalled transfer is tolerated before the push is dropped"
	default 30

config RVT_PUSHER_STALL_MS
	int "Milliseconds to wait for the flash writer before declaring a stall"
	default 15000
	help
	  A buffer should come back in ~35 ms. Seconds means the flash operation
	  is not returning at all, which FSP can do - several of its register
	  waits are unbounded spins. The listener stops draining the socket
	  while it waits here, so an unbounded wait shows up on the host as a
	  mid-transfer stall with a silent, healthy-looking board.

config RVT_PUSHER_BUF
	int "Size of each of the two receive buffers, bytes"
	default 8192
	help
	  The socket fills one while the flash programs the other. Bigger
	  buffers mean longer aligned flash writes; two of these live in .bss
	  for the life of the application.

	  Must be a multiple of 16, and src/pusher.c BUILD_ASSERTs it: this part
	  computes ECC over 16-byte units and forbids programming one twice
	  without an erase between, so a buffer that did not end on a unit
	  boundary would have every write reprogram the unit the previous write
	  left half done.

config RVT_PUSHER_THREAD_PRIORITY
	int "Listener thread priority"
	default 7
	help
	  Between the telnet thread (5) and the emulator (10), and both bounds
	  matter.

	  Above the emulator because the banner and header exchange happen
	  while the guest is still running - the guest is only stopped once the
	  header validates - and the emulator loop never blocks or yields, so a
	  pusher at or below 10 would never be scheduled to read the header
	  that is going to stop it.

	  Below telnet because an attached console is interactive and a push is
	  not: the pusher spends minutes at a time inside flash operations, and
	  the console's 5 ms poll should keep winning through it.

config RVT_PUSHER_WRITER_PRIORITY
	int "Flash writer thread priority"
	default 8
	help
	  One below the listener, so draining the socket beats programming
	  flash when both are runnable. That is the right way round: the flash
	  is the slower end and TCP is what stalls if it is not read.

config RVT_PUSHER_THREAD_STACK
	int "Listener thread stack size"
	default 3072

config RVT_PUSHER_WRITER_STACK
	int "Flash writer thread stack size"
	default 2048

endif # RVT_PUSHER

endmenu

menu "Networking bring-up"
	depends on NETWORKING

config RVT_NET_STATIC_IP
	bool "Configure a static IPv4 address instead of using DHCP"
	default n

config RVT_NET_ADDR
	string "Static IPv4 address"
	default "192.168.1.50"
	depends on RVT_NET_STATIC_IP

config RVT_NET_NETMASK
	string "Static IPv4 netmask"
	default "255.255.255.0"
	depends on RVT_NET_STATIC_IP

config RVT_NET_GATEWAY
	string "Static IPv4 gateway"
	default "192.168.1.1"
	depends on RVT_NET_STATIC_IP

config RVT_NET_DHCP_WAIT_S
	int "Seconds to wait for DHCP before booting the guest"
	default 15
	depends on !RVT_NET_STATIC_IP
	help
	  Boot is held here only so the address can be printed on the console
	  before the guest's own output starts. On timeout the guest boots
	  anyway and DHCP keeps running in the background; the address is
	  printed whenever it does arrive.

config RVT_NET_FALLBACK_ADDR
	string "Static IPv4 address to apply if DHCP times out"
	default ""
	depends on !RVT_NET_STATIC_IP
	help
	  Leave empty to disable. DHCP is left running, so a lease arriving
	  later still takes effect.

config RVT_NET_FALLBACK_NETMASK
	string "Netmask for the DHCP fallback address"
	default "255.255.255.0"
	depends on !RVT_NET_STATIC_IP

endmenu

menu "Guest network interface"

config RVT_GUEST_NET
	bool "Give the guest a virtio-net NIC bridged to the real Ethernet"
	default y
	depends on NETWORKING && NET_L2_ETHERNET
	select NET_PROMISCUOUS_MODE
	select NET_SOCKETS_PACKET
	help
	  A virtio-net device in the emulated machine, backed by eth0 in
	  promiscuous mode: the guest gets its own MAC (the board's with the
	  local bit set and the last byte inverted) and its own DHCP lease on
	  the segment, so ssh/scp reach it directly. src/netbridge.c filters
	  the segment's traffic for the guest MAC, broadcast and multicast.

	  NET_PROMISCUOUS_MODE needs driver support - eth_renesas_ra.c gained
	  .set_config in the zephyr fork (8ca5eb88530); without that commit
	  this option prints "promiscuous mode REFUSED" and the guest NIC is
	  deaf. NET_SOCKETS_PACKET is what makes ethernet L2 transmit the
	  guest's raw frames verbatim (ethernet.c "Raw packet, just send it").

if RVT_GUEST_NET

config RVT_NET_GUEST_RX_RING
	int "Wire-to-guest frame ring, bytes (power of two)"
	default 8192
	help
	  Holds length-prefixed whole frames between the promiscuous RX
	  thread and the emulator's once-per-slice poll. Five full-size
	  frames; a burst beyond that is dropped and counted, which is what a
	  real NIC with a full ring does too.

config RVT_NET_GUEST_THREAD_PRIORITY
	int "Filter thread priority"
	default 6
	help
	  Below telnet (5), above the emulator (10): a flood of segment
	  traffic must not starve the console, but filtering must still
	  preempt the guest or the ring only drains at slice boundaries.

config RVT_NET_GUEST_THREAD_STACK
	int "Filter thread stack size"
	default 2048

endif # RVT_GUEST_NET

endmenu

source "Kconfig.zephyr"
